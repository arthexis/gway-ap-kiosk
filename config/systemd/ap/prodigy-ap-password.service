[Unit]
Description=Rotate PRODIGY AP password once per boot before NetworkManager starts
DefaultDependencies=no
After=local-fs.target
Before=NetworkManager.service
ConditionPathExists=/etc/NetworkManager/system-connections

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/prodigy-ap-password boot-rotate

[Install]
WantedBy=NetworkManager.service

