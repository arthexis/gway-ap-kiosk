[Unit]
Description=Standalone local RFID scan publisher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=arthe
WorkingDirectory=/home/arthe
SupplementaryGroups=gpio spi
Environment=PYTHONUNBUFFERED=1
Environment=RFID_SCAN_FILE=/home/arthe/.local/state/rfid-mode/rfid-scan.json
Environment=RFID_SCAN_LOG_FILE=/home/arthe/.local/state/rfid-mode/rfid-scans.ndjson
Environment=RFID_SCAN_EVENT_LOG=/home/arthe/.local/state/rfid-mode/events.ndjson
Environment=RFID_SCAN_STATUS_FILE=/home/arthe/.local/state/rfid-mode/rfid-scan-publisher.json
Environment=RFID_SCAN_LCD_LOCK_DIR=/home/arthe/.local/state/lcd-lockfiles
Environment=RFID_SCAN_CARDS_FILE=/home/arthe/cards.txt
Environment=RFID_SCAN_NORMAL_SOUND=notice
Environment=RFID_SCAN_DEEP_SOUND=ok
ExecStart=/home/arthe/.local/share/rfid-mode/.venv/bin/python /home/arthe/.local/bin/rfid-scan-publisher
Restart=always
RestartSec=2
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
