# Refresh HDMI kiosk output role when the bastion USB key is inserted or removed.
#
# Replace the example bastion selectors with local values from:
#
#   udevadm info --query=property --name=/dev/<partition>
#
# Do not commit filled serial numbers or filesystem UUIDs.

ACTION=="add|change", SUBSYSTEM=="block", ENV{ID_FS_UUID}=="<BASTION_ID_FS_UUID>", ENV{UDISKS_IGNORE}="1", ENV{UDISKS_AUTO}="0"
ACTION=="add|change", SUBSYSTEM=="block", ENV{ID_SERIAL_SHORT}=="<BASTION_ID_SERIAL_SHORT>", ENV{UDISKS_IGNORE}="1", ENV{UDISKS_AUTO}="0"
ACTION=="add|remove", SUBSYSTEM=="block", ENV{ID_FS_UUID}=="<BASTION_ID_FS_UUID>", TAG+="systemd", ENV{SYSTEMD_WANTS}+="arthexis-hdmi-kiosk-layout.service"
ACTION=="add|remove", SUBSYSTEM=="block", ENV{ID_SERIAL_SHORT}=="<BASTION_ID_SERIAL_SHORT>", TAG+="systemd", ENV{SYSTEMD_WANTS}+="arthexis-hdmi-kiosk-layout.service"
