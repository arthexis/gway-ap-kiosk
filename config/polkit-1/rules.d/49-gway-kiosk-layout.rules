// Allow the kiosk status service user to start only its layout unit without sudo.
polkit.addRule(function(action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units"
        && subject.user === "arthe"
        && action.lookup("verb") === "start"
        && action.lookup("unit") === "gway-hdmi-kiosk-layout.service") {
        return polkit.Result.YES;
    }
});
