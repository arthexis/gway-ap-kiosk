table inet arthexis_ap_portal {
    set authorized_macs {
        type ether_addr
    }

    set preauth_ipv4 {
        type ipv4_addr
        flags interval
    }

    set preauth_ipv6 {
        type ipv6_addr
        flags interval
    }

    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;
        iifname "wlan0" ip daddr @preauth_ipv4 tcp dport { 80, 443 } return
        iifname "wlan0" ip6 daddr @preauth_ipv6 tcp dport { 80, 443 } return
        iifname "wlan0" tcp dport 80 jump portal_redirect
    }

    chain portal_redirect {
        ether saddr @authorized_macs return
        meta l4proto tcp redirect to :80
    }

    chain forward {
        type filter hook forward priority -5; policy accept;
        iifname "wlan0" ether saddr @authorized_macs accept
        iifname "wlan0" ip daddr @preauth_ipv4 tcp dport { 80, 443 } accept
        iifname "wlan0" ip6 daddr @preauth_ipv6 tcp dport { 80, 443 } accept
        iifname "wlan0" drop
    }
}
