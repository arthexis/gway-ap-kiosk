# Copy to /etc/default/arthexis-wifi-role and edit for the local box.
# Do not commit a filled copy: connection profile names can identify private
# sites, and NetworkManager profile files may contain PSKs.

# NetworkManager connection profile that provides the local AP on AP_INTERFACE.
AP_CONNECTION=arthexis-ap

# Interface that normally hosts the local AP.
AP_INTERFACE=wlan0

# Interface that normally carries upstream internet.
UPLINK_INTERFACE=wlan1

# Interface used for SSID scans. Leave blank to scan UPLINK_INTERFACE.
SCAN_INTERFACE=wlan1

# Comma-separated fallback client connection profile names that may be activated
# on AP_INTERFACE only when UPLINK_INTERFACE is down and a matching SSID is
# visible or recently seen.
PREFERRED_CLIENT_CONNECTIONS=site-uplink-primary,site-uplink-backup

# Runtime state written by the systemd service. This is state, not source.
STATE_FILE=/var/lib/arthexis-wifi-role/state.json

# Tuning values in seconds.
RECENT_SSID_TTL_SECONDS=45
FAILOVER_RETRY_SECONDS=4
FAILOVER_RETRY_INTERVAL_SECONDS=2
FALLBACK_FAILURE_COOLDOWN_SECONDS=90
CONNECTED_SCAN_INTERVAL_SECONDS=20
