#!/usr/bin/env bash
set -Eeuo pipefail

ENV_FILE=/etc/default/arthexis-vnc-kiosk
if [[ -r "${ENV_FILE}" ]]; then
  # shellcheck disable=SC1090
  source "${ENV_FILE}"
fi

: "${KIOSK_GEOMETRY:=1280x720}"
: "${KIOSK_URL:=http://127.0.0.1:8888/}"
: "${KIOSK_BROWSER:=/usr/bin/chromium}"
: "${KIOSK_WINDOW_MANAGER:=/usr/bin/openbox}"
: "${KIOSK_OPENBOX_CONFIG:=/etc/arthexis-kiosk/openbox-rc.xml}"
: "${KIOSK_EXTRA_CHROMIUM_FLAGS:=}"
: "${KIOSK_WINDOW_TOP_CROP_PIXELS:=0}"
: "${KIOSK_WHATSAPP_PANEL:=0}"
: "${KIOSK_PRIMARY_WIDTH_PERCENT:=75}"
: "${KIOSK_WHATSAPP_URL:=https://web.whatsapp.com/}"
: "${KIOSK_WHATSAPP_PROFILE_DIR:=${HOME}/whatsapp-profile}"
: "${KIOSK_WHATSAPP_CACHE_DIR:=${HOME}/whatsapp-cache}"
: "${KIOSK_WHATSAPP_EXTRA_CHROMIUM_FLAGS:=}"
: "${KIOSK_WHATSAPP_LEFT_CROP_PIXELS:=0}"
: "${KIOSK_RFID_AUTO_DISPLAY:=0}"
: "${KIOSK_RFID_AUTO_DISPLAY_TOKEN_FILE:=/var/lib/arthexis-hdmi-kiosk/rfid-auto-display.token}"
: "${KIOSK_RESTACK_WINDOWS:=1}"
: "${KIOSK_WMCTRL:=/usr/bin/wmctrl}"

normalize_kiosk_url() {
  local token=""
  if [[ -r "${KIOSK_RFID_AUTO_DISPLAY_TOKEN_FILE}" ]]; then
    token="$(tr -d '\r\n' < "${KIOSK_RFID_AUTO_DISPLAY_TOKEN_FILE}")"
  fi
  /usr/bin/python3 - "${KIOSK_URL}" "${KIOSK_RFID_AUTO_DISPLAY}" "${token}" <<'PY'
import sys
from urllib.parse import parse_qsl, urlencode, urlsplit, urlunsplit

url = sys.argv[1]
auto_display = sys.argv[2].strip().lower() in {"1", "true", "yes", "on"}
token = sys.argv[3].strip()
parts = urlsplit(url)
query_pairs = [
    (key, value)
    for key, value in parse_qsl(parts.query, keep_blank_values=True)
    if key not in {"kiosk", "rfid_auto_display", "kiosk_rfid_auto_display_token"}
]
query_pairs.append(("kiosk", "1"))
if auto_display:
    query_pairs.append(("rfid_auto_display", "1"))
    if token:
        query_pairs.append(("kiosk_rfid_auto_display_token", token))
print(
    urlunsplit(
        (
            parts.scheme,
            parts.netloc,
            parts.path or "/",
            urlencode(query_pairs, doseq=True),
            parts.fragment,
        )
    )
)
PY
}

KIOSK_URL="$(normalize_kiosk_url)"

truthy() {
  [[ "${1:-}" =~ ^(1|yes|true|on)$ ]]
}

split_window_geometry() {
  /usr/bin/python3 - "${window_size}" "${KIOSK_PRIMARY_WIDTH_PERCENT}" "${KIOSK_WINDOW_TOP_CROP_PIXELS}" "${KIOSK_WHATSAPP_LEFT_CROP_PIXELS}" <<'PY'
import sys

try:
    width_s, height_s = sys.argv[1].split(",", 1)
    width = int(width_s)
    height = int(height_s)
except (ValueError, IndexError):
    width, height = 1280, 720

try:
    percent = int(sys.argv[2])
except (ValueError, IndexError):
    percent = 75

try:
    top_crop = int(sys.argv[3])
except (ValueError, IndexError):
    top_crop = 0

try:
    left_crop = int(sys.argv[4])
except (ValueError, IndexError):
    left_crop = 0

percent = min(90, max(50, percent))
top_crop = min(160, max(0, top_crop))
primary_width = max(1, width * percent // 100)
secondary_width = max(1, width - primary_width)

if width >= 960 and secondary_width < 320:
    secondary_width = 320
    primary_width = width - secondary_width

left_crop = min(max(0, left_crop), max(0, primary_width - 1))
full_height = height + top_crop
status_position = f"0,{-top_crop}" if top_crop else "0,0"
whatsapp_position = f"{primary_width - left_crop},{-top_crop}" if top_crop else f"{primary_width - left_crop},0"
single_window_size = f"{width},{full_height}"

print(
    f"{primary_width},{full_height} "
    f"{secondary_width + left_crop},{full_height} "
    f"{whatsapp_position} "
    f"{status_position} "
    f"{single_window_size}"
)
PY
}

export HOME=/var/lib/arthexis-vnc-kiosk
export XDG_CONFIG_HOME="${HOME}/.config"
export XDG_CACHE_HOME="${HOME}/.cache"
export XDG_DATA_HOME="${HOME}/.local/share"
export XDG_DATA_DIRS="${XDG_DATA_HOME}"
export XDG_RUNTIME_DIR="${HOME}/runtime"
export XDG_CURRENT_DESKTOP=Openbox
export DESKTOP_SESSION=openbox
export GIO_USE_VFS=local
export GTK_USE_PORTAL=0
export NO_AT_BRIDGE=1

mkdir -p \
  "${XDG_CONFIG_HOME}" \
  "${XDG_CACHE_HOME}" \
  "${XDG_DATA_HOME}" \
  "${XDG_RUNTIME_DIR}" \
  "${HOME}/chromium-cache" \
  "${HOME}/chromium-profile"
chmod 0700 "${XDG_RUNTIME_DIR}"

if truthy "${KIOSK_WHATSAPP_PANEL}"; then
  mkdir -p "${KIOSK_WHATSAPP_PROFILE_DIR}" "${KIOSK_WHATSAPP_CACHE_DIR}"
  chmod 0700 "${KIOSK_WHATSAPP_PROFILE_DIR}" "${KIOSK_WHATSAPP_CACHE_DIR}"
fi

xset -dpms s off s noblank >/dev/null 2>&1 || true

restack_vnc_windows() {
  local attempt window_list status_id whatsapp_id
  if ! truthy "${KIOSK_RESTACK_WINDOWS}" || [[ ! -x "${KIOSK_WMCTRL}" ]]; then
    return 0
  fi

  for attempt in {1..60}; do
    window_list="$("${KIOSK_WMCTRL}" -lx -G 2>/dev/null || true)"
    status_id="$(awk '$0 ~ /arthexis-vnc-kiosk/ && $0 !~ /arthexis-vnc-kiosk-whatsapp/ { print $1; exit }' <<< "${window_list}")"
    whatsapp_id="$(awk '$0 ~ /arthexis-vnc-kiosk-whatsapp/ { print $1; exit }' <<< "${window_list}")"

    if [[ -n "${status_id}" && -n "${whatsapp_id}" ]]; then
      "${KIOSK_WMCTRL}" -i -r "${whatsapp_id}" -b remove,above >/dev/null 2>&1 || true
      "${KIOSK_WMCTRL}" -i -r "${whatsapp_id}" -b add,below,skip_taskbar >/dev/null 2>&1 || true
      "${KIOSK_WMCTRL}" -i -r "${status_id}" -b remove,below >/dev/null 2>&1 || true
      "${KIOSK_WMCTRL}" -i -r "${status_id}" -b add,above,skip_taskbar >/dev/null 2>&1 || true
      "${KIOSK_WMCTRL}" -i -a "${status_id}" >/dev/null 2>&1 || true
      return 0
    fi

    sleep 0.2
  done
}

pids=()
cleanup() {
  local pid
  for pid in "${pids[@]:-}"; do
    if kill -0 "${pid}" 2>/dev/null; then
      kill "${pid}" 2>/dev/null || true
    fi
  done
  wait "${pids[@]:-}" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

"${KIOSK_WINDOW_MANAGER}" --config-file "${KIOSK_OPENBOX_CONFIG}" &
wm_pid=$!
pids+=("${wm_pid}")

width="${KIOSK_GEOMETRY%x*}"
height="${KIOSK_GEOMETRY#*x}"
height="${height%%[!0-9]*}"
window_size="${width},${height}"
read -r status_window_size whatsapp_window_size whatsapp_window_position status_window_position single_window_size <<< "$(split_window_geometry)"

# Intentionally run a browser directly in kiosk mode. Network access is also
# constrained by the systemd unit to loopback only.
read -r -a extra_flags <<< "${KIOSK_EXTRA_CHROMIUM_FLAGS}"
read -r -a whatsapp_extra_flags <<< "${KIOSK_WHATSAPP_EXTRA_CHROMIUM_FLAGS}"

status_common_flags=(
  "${KIOSK_BROWSER}"
  --class=arthexis-vnc-kiosk
  --name=arthexis-vnc-kiosk
  --window-position="${status_window_position}"
  --user-data-dir="${HOME}/chromium-profile" \
  --disk-cache-dir="${HOME}/chromium-cache" \
  --no-first-run \
  --no-default-browser-check \
  --test-type \
  --disable-background-networking \
  --disable-component-update \
  --disable-crash-reporter \
  --disable-extensions \
  --disable-features=AutofillServerCommunication,MediaRouter,OptimizationHints,Translate,WebRtcPipeWireCapturer \
  --disable-gpu \
  --disable-print-preview \
  --disable-session-crashed-bubble \
  --disable-sync \
  --noerrdialogs \
  --no-proxy-server \
  --host-resolver-rules="MAP * 0.0.0.0,EXCLUDE localhost,EXCLUDE 127.0.0.1,EXCLUDE cdn.jsdelivr.net,EXCLUDE cdnjs.cloudflare.com,EXCLUDE raw.githubusercontent.com,EXCLUDE img.shields.io" \
  --overscroll-history-navigation=0 \
  --password-store=basic \
  "${extra_flags[@]}"
)

if truthy "${KIOSK_WHATSAPP_PANEL}"; then
  "${KIOSK_BROWSER}" \
    --class=arthexis-vnc-kiosk-whatsapp \
    --name=arthexis-vnc-kiosk-whatsapp \
    --app="${KIOSK_WHATSAPP_URL}" \
    --window-position="${whatsapp_window_position}" \
    --window-size="${whatsapp_window_size}" \
    --user-data-dir="${KIOSK_WHATSAPP_PROFILE_DIR}" \
    --disk-cache-dir="${KIOSK_WHATSAPP_CACHE_DIR}" \
    --no-first-run \
    --no-default-browser-check \
    --test-type \
    --disable-component-update \
    --disable-crash-reporter \
    --disable-features=Translate \
    --disable-print-preview \
    --disable-session-crashed-bubble \
    --disable-sync \
    --disable-dev-shm-usage \
    --noerrdialogs \
    --no-proxy-server \
    --overscroll-history-navigation=0 \
    --password-store=basic \
    "${whatsapp_extra_flags[@]}" &
  whatsapp_pid=$!
  pids+=("${whatsapp_pid}")

  sleep 0.4
  "${status_common_flags[@]}" \
    --app="${KIOSK_URL}" \
    --window-size="${status_window_size}" &
  status_pid=$!
  pids+=("${status_pid}")
  restack_vnc_windows &

  wait -n "${status_pid}" "${whatsapp_pid}"
else
  "${status_common_flags[@]}" \
    --kiosk "${KIOSK_URL}" \
    --window-size="${single_window_size}" &
  browser_pid=$!
  pids+=("${browser_pid}")

  wait "${browser_pid}"
fi
