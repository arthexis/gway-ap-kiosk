ShareFiles=0
EnableRemotePrinting=0
ServiceDiscoveryEnabled=0
AllowCloudRfb=0
AllowCloudRelay=0
AllowConnTransferRfb=0
GuestAccessEnable=0
SessionRecordEnable=0
AllowDynamicResolution=0
DisableOptions=1
DisableClose=1
DisableAddNewClient=1
QueryConnect=0
IdleTimeout=900
StartUI=0
DisableTrayIcon=1
AudioEnable=0
ConnNotifyTimeout=0
EnableAnalytics=0

