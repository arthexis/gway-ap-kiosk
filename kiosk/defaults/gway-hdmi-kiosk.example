KIOSK_URL='http://127.0.0.1:8899/kiosk/status/'
KIOSK_BROWSER=/usr/bin/chromium
KIOSK_APP_ID=gway-hdmi-kiosk
KIOSK_TARGET_OUTPUT=HDMI-A-2
KIOSK_REQUIRE_TARGET_OUTPUT=0
KIOSK_WINDOW_SIZE=auto
KIOSK_SESSION_RUNTIME_DIR=/run/user/1000
KIOSK_WAYLAND_DISPLAY=wayland-0
KIOSK_DISPLAY=:0
KIOSK_XAUTHORITY=/home/arthe/.Xauthority
KIOSK_ALLOWED_HOSTS=localhost,127.0.0.1,cdn.jsdelivr.net,cdnjs.cloudflare.com,raw.githubusercontent.com,img.shields.io
KIOSK_HOST_RESOLVER_RULES=
KIOSK_PRIVATE_SESSION=0
KIOSK_DISABLE_PASSWORD_MANAGER=1
KIOSK_EXTRA_CHROMIUM_FLAGS=
KIOSK_WINDOW_TOP_CROP_PIXELS=32
KIOSK_WHATSAPP_PANEL=0
KIOSK_PRIMARY_WIDTH_PERCENT=75
KIOSK_WHATSAPP_URL='https://web.whatsapp.com/'
KIOSK_WHATSAPP_PROFILE_DIR='/home/arthe/.config/whatsapp-kiosk-panel'
KIOSK_WHATSAPP_CACHE_DIR='/home/arthe/.cache/whatsapp-kiosk-panel'
KIOSK_WHATSAPP_EXTRA_CHROMIUM_FLAGS=
KIOSK_WHATSAPP_LEFT_CROP_PIXELS=0
KIOSK_SUSPEND=0
KIOSK_BASTION_CHECK=/usr/local/libexec/bastion-key-present
KIOSK_MANUAL_STATE_FILE=/run/user/1000/gway-hdmi-kiosk/manual-enabled
KIOSK_HIDE_WF_PANEL=1
