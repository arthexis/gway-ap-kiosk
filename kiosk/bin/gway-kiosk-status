TAKEOVER_TEXT_LIMIT = 280
TAKEOVER_TITLE_LIMIT = 80
LAYOUT_VERSION = "gway-local-kiosk-todo-v1"


def env_path(name: str, default: Path) -> Path:
    return Path(os.environ.get(name, str(default)))


def env_int(name: str, default: int, *, minimum: int = 0, maximum: int | None = None) -> int:
    try:
        value = int(os.environ.get(name, str(default)))
    except ValueError:
        value = default
    value = max(minimum, value)
    if maximum is not None:
        value = min(maximum, value)
    return value


def local_tz() -> ZoneInfo:
    name = os.environ.get("GWAY_KIOSK_TIMEZONE", "America/Monterrey").strip()
    try:
        return ZoneInfo(name)
    except Exception:
        return ZoneInfo("UTC")


def read_key_value_file(path: Path) -> dict[str, str]:
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return {}
    values: dict[str, str] = {}
    for line in lines:
        key, separator, value = line.partition("=")
        if separator:
            values[key.strip().upper()] = value.strip().strip("'\"")
    return values


def read_json_file(path: Path) -> dict[str, Any]:
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, TypeError, json.JSONDecodeError, UnicodeDecodeError):
        return {}
    return payload if isinstance(payload, dict) else {}


def parse_datetime(value: object) -> datetime | None:
    if isinstance(value, datetime):
        parsed = value
    else:
        text = str(value or "").strip()
        if not text:
            return None
        if text.endswith("Z"):
            text = f"{text[:-1]}+00:00"
        try:
            parsed = datetime.fromisoformat(text)
        except ValueError:
            return None
    if parsed.tzinfo is None:
        return parsed.replace(tzinfo=local_tz())
    return parsed


def display_datetime(value: datetime | str | None) -> str:
    parsed = parse_datetime(value)
    if parsed is None:
        return str(value or "")
    return parsed.astimezone(local_tz()).strftime("%Y-%m-%d %H:%M:%S %Z")


def file_mtime(path: Path) -> datetime | None:
    try:
        return datetime.fromtimestamp(path.stat().st_mtime, tz=timezone.utc)
    except OSError:
        return None


def format_duration(seconds: float) -> str:
    total_seconds = max(0, int(seconds))
    days, remainder = divmod(total_seconds, 86400)
    hours, remainder = divmod(remainder, 3600)
    minutes = remainder // 60
    if not days and not hours and not minutes:
        return "<1m"
    parts: list[str] = []
    if days:
        parts.append(f"{days}d")
    if days or hours:
        parts.append(f"{hours}h")
    parts.append(f"{minutes}m")
    return " ".join(parts)


def format_bytes(value: float) -> str:
    units = ("B", "KB", "MB", "GB", "TB")
    size = float(max(0, value))
    for unit in units:
        if size < 1024 or unit == units[-1]:
            if unit == "B":
                return f"{int(size)} {unit}"
            return f"{size:.1f} {unit}"
        size /= 1024
    return f"{size:.1f} TB"


def truthy(value: object) -> bool:
    return str(value or "").strip().lower() in {"1", "true", "yes", "on"}


def clean_text(value: object, limit: int) -> str:
    text = str(value if value is not None else "").replace("\x00", "").strip()
    text = re.sub(r"\s+", " ", text)
    if len(text) <= limit:
        return text
    return text[: limit - 3].rstrip() + "..."


def detail(label: str, value: object) -> dict[str, str]:
    return {"label": label, "value": clean_text(value, 160)}


def yes_no(value: object) -> str:
    if value is True:
        return "yes"
    if value is False:
        return "no"
    if value is None or value == "":
        return ""
    return str(value)


def client_is_loopback(client_ip: str) -> bool:
    return client_ip in {"127.0.0.1", "::1", "localhost"}


def qr_escape(value: str) -> str:
    return (
        value.replace("\\", "\\\\")
        .replace(";", r"\;")
        .replace(",", r"\,")
        .replace(":", r"\:")
    )


def wifi_qr_payload(*, ssid: str, password: str) -> str:
    if not ssid:
        return ""
    return f"WIFI:T:WPA;S:{qr_escape(ssid)};P:{qr_escape(password)};;"


def qr_data_uri(payload: str) -> str:
    if not payload:
        return ""
    try:
        import qrcode
    except ModuleNotFoundError as exc:
        if exc.name == "qrcode":
            return ""
        raise
    qr = qrcode.QRCode(box_size=4, border=1)
    qr.add_data(payload)
    qr.make(fit=True)
    image = qr.make_image(fill_color="black", back_color="white")
    buffer = BytesIO()
    image.save(buffer, format="PNG")
    return "data:image/png;base64," + base64.b64encode(buffer.getvalue()).decode("ascii")


def run_status_command(args: list[str], *, timeout: float = 0.8) -> str:
    try:
        result = subprocess.run(
            args,
            capture_output=True,
            check=False,
            text=True,
            timeout=timeout,
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    return (result.stdout or result.stderr or "").strip()


def service_status(name: str) -> dict[str, object]:
    output = run_status_command(["systemctl", "is-active", name])
    state = (output or "unknown").splitlines()[0]
    return {
        "name": name,
        "label": name.removesuffix(".service").removesuffix(".timer"),
        "state": state,
        "ok": state == "active",
    }


def service_statuses() -> list[dict[str, object]]:
    configured = os.environ.get("GWAY_KIOSK_STATUS_SERVICES", "")
    services = [part.strip() for part in configured.split(",") if part.strip()]
    if not services:
        services = list(DEFAULT_STATUS_SERVICES)
    return [service_status(service) for service in services]


def portal_health() -> dict[str, object]:
    url = os.environ.get("GWAY_KIOSK_AP_PORTAL_HEALTH_URL", DEFAULT_PORTAL_HEALTH_URL).strip()
    if not url:
        return {"configured": False, "ok": False, "label": "AP portal", "state": "off"}
    try:
        with urlopen(url, timeout=0.5) as response:  # noqa: S310 - local kiosk probe.
            status_code = response.status
    except (OSError, TimeoutError, URLError, ValueError):
        return {"configured": True, "ok": False, "label": "AP portal", "state": "down"}
    return {
        "configured": True,
        "ok": 200 <= int(status_code) < 500,
        "label": "AP portal",
        "state": str(status_code),
    }


def loopback_http_url(value: str) -> str:
    """Return a safe local HTTP URL, rejecting arbitrary kiosk targets."""

    try:
        parsed = urlsplit(value)
    except ValueError:
        return ""
    if (
        parsed.scheme != "http"
        or parsed.hostname not in {"127.0.0.1", "::1", "localhost"}
        or parsed.username
        or parsed.password
    ):
        return ""
    return urlunsplit(parsed)


def csv_values(value: str) -> list[str]:
    """Return non-empty, trimmed values from a comma-separated setting."""

    return [item.strip() for item in value.split(",") if item.strip()]


def interface_has_carrier(interface: str) -> bool:
    """Return whether the configured local Ethernet interface has carrier."""

    if not re.fullmatch(r"[A-Za-z0-9_.-]+", interface):
        return False
    try:
        carrier_file = Path("/sys/class/net") / interface / "carrier"
        return carrier_file.read_text().strip() == "1"
    except OSError:
        return False


def field_view_context() -> dict[str, object]:
    """Return whether an armed field kiosk may show the suite charger view."""

    enabled = truthy(os.environ.get("KIOSK_FIELD_VIEW_ENABLED"))
    state_file = env_path("KIOSK_FIELD_VIEW_STATE_FILE", DEFAULT_FIELD_VIEW_STATE_FILE)
    required_interface = os.environ.get(
        "KIOSK_FIELD_VIEW_REQUIRED_INTERFACE", DEFAULT_FIELD_VIEW_REQUIRED_INTERFACE
    ).strip()
    view_url = loopback_http_url(
        os.environ.get("KIOSK_FIELD_VIEW_URL", DEFAULT_FIELD_VIEW_URL).strip()
    )
    context: dict[str, object] = {
        "enabled": enabled,
        "armed": state_file.is_file(),
        "available": False,
        "reason": "disabled",
        "required_interface": required_interface,
        "carrier": None,
        "charger_count": 0,
        "view_url": view_url,
    }
    if not enabled:
        return context
    if not context["armed"]:
        context["reason"] = "not_armed"
        return context
    if not view_url:
        context["reason"] = "invalid_view_url"
        return context
    if required_interface:
        carrier = interface_has_carrier(required_interface)
        context["carrier"] = carrier
        if not carrier:
            context["reason"] = "no_interface_carrier"
            return context

    live_url = loopback_http_url(
        os.environ.get(
            "KIOSK_FIELD_VIEW_LIVE_CONNECTION_URL",
            DEFAULT_FIELD_VIEW_LIVE_CONNECTION_URL,
        ).strip()
    )
    if not live_url:
        context["reason"] = "invalid_live_connection_url"
        return context
    charger_ids = csv_values(os.environ.get("KIOSK_FIELD_VIEW_CHARGER_IDS", ""))
    parsed = urlsplit(live_url)
    query = parse_qsl(parsed.query, keep_blank_values=True)
    query.extend(("charger_id", charger_id) for charger_id in charger_ids)
    live_url = urlunsplit(parsed._replace(query=urlencode(query, doseq=True)))
    try:
        with urlopen(live_url, timeout=0.75) as response:  # noqa: S310 - validated loopback URL.
            if not 200 <= response.status < 300:
                context["reason"] = "live_connection_unavailable"
                return context
            payload = json.loads(response.read().decode("utf-8"))
    except (OSError, TimeoutError, URLError, ValueError, json.JSONDecodeError):
        context["reason"] = "live_connection_unavailable"
        return context
    if not isinstance(payload, dict) or not payload.get("connected"):
        context["reason"] = "no_live_ocpp_connection"
        return context
    try:
        context["charger_count"] = max(0, int(payload.get("charger_count") or 0))
    except (TypeError, ValueError):
        context["charger_count"] = 0
    if not context["charger_count"]:
        context["reason"] = "no_live_ocpp_connection"
        return context
    context["available"] = True
    context["reason"] = "live_ocpp_connection"
    return context


def ap_context(client_ip: str) -> dict[str, object]:
    path = env_path("GWAY_KIOSK_AP_PASSWORD_FILE", DEFAULT_AP_PASSWORD_FILE)
    values = read_key_value_file(path)
    ssid = values.get("SSID", "")
    password = values.get("PASSWORD", "")
    password_visible = truthy(os.environ.get("GWAY_KIOSK_EXPOSE_AP_PASSWORD_TO_REMOTE")) or client_is_loopback(client_ip)
    visible_password = password if password_visible else ""
    qr_payload = wifi_qr_payload(ssid=ssid, password=password) if password_visible and password else ""
    return {
        "available": bool(ssid and password),
        "ssid": ssid,
        "password": visible_password,
        "password_visible": password_visible,
        "updated_at": values.get("UPDATED_AT", ""),
        "updated_at_display": display_datetime(values.get("UPDATED_AT", "")),
        "interface": values.get("INTERFACE", ""),
        "file_path": str(path),
        "qr_payload": qr_payload,
        "qr_data_uri": qr_data_uri(qr_payload),
    }


def scan_state_paths() -> list[Path]:
    configured = os.environ.get("GWAY_KIOSK_RFID_SCAN_FILES", "")
    if configured.strip():
        return [Path(part.strip()) for part in configured.split(":") if part.strip()]
    return [DEFAULT_HOST_RFID_SCAN_FILE, DEFAULT_SUITE_RFID_SCAN_FILE]


def scan_payload_time(payload: dict[str, Any], path: Path) -> datetime | None:
    for key in ("last_presence_at", "scanned_at", "written_at"):
        parsed = parse_datetime(payload.get(key))
        if parsed is not None:
            return parsed
    deep_scan = payload.get("deep_scan")
    if isinstance(deep_scan, dict):
        for key in ("completed_at", "attempted_at"):
            parsed = parse_datetime(deep_scan.get(key))
            if parsed is not None:
                return parsed
    return file_mtime(path)


def latest_scan_payload() -> tuple[dict[str, Any], str, datetime | None]:
    latest_payload: dict[str, Any] = {}
    latest_path = ""
    latest_time: datetime | None = None
    for path in scan_state_paths():
        payload = read_json_file(path)
        if not payload:
            continue
        timestamp = scan_payload_time(payload, path)
        if latest_time is None or (timestamp is not None and timestamp > latest_time):
            latest_payload = payload
            latest_path = str(path)
            latest_time = timestamp
    return latest_payload, latest_path, latest_time


def latest_card_time() -> datetime | None:
    payload, _source, timestamp = latest_scan_payload()
    return timestamp if payload else None


def command_details(payload: dict[str, Any]) -> dict[str, str]:
    command_card = payload.get("command_card")
    if not isinstance(command_card, dict):
        command_card = {}
    command_execution = payload.get("command_execution")
    if not isinstance(command_execution, dict):
        command_execution = {}
    return {
        "card_name": clean_text(
            command_card.get("name")
            or payload.get("card_name")
            or payload.get("display_label")
            or "",
            120,
        ),
        "command": clean_text(command_card.get("command") or "", 120),
        "template": clean_text(command_card.get("template") or "", 120),
        "execution_status": clean_text(command_execution.get("status") or "", 80),
        "execution_detail": clean_text(
            command_execution.get("status_detail")
            or command_execution.get("summary")
            or "",
            160,
        ),
    }


def last_card_context() -> dict[str, object]:
    payload, source_path, timestamp = latest_scan_payload()
    if not payload:
        return {
            "available": False,
            "source": "",
            "display_label": "No card seen",
            "rfid": "",
            "full_rfid": "",
            "seen_at": "",
            "status": "idle",
            "command": {},
            "details": [],
        }
    rfid_value = clean_text(str(payload.get("rfid", "") or "").upper(), 80)
    deep_scan = payload.get("deep_scan")
    if not isinstance(deep_scan, dict):
        deep_scan = {}
    dump = payload.get("dump")
    return {
        "available": True,
        "source": "Scanner state",
        "display_label": clean_text(
            payload.get("display_label")
            or payload.get("card_name")
            or payload.get("generated_label")
            or rfid_value
            or "Unknown card",
            120,
        ),
        "rfid": rfid_value,
        "full_rfid": rfid_value,
        "seen_at": display_datetime(timestamp),
        "status": "present" if payload.get("card_present") else "last seen",
        "command": command_details(payload),
        "details": [
            detail("Kind", payload.get("kind", "")),
            detail("Allowed", yes_no(payload.get("allowed"))),
            detail("Deep read", yes_no(payload.get("deep_read"))),
            detail("Deep scan", deep_scan.get("status", "")),
            detail("Blocks", len(dump) if isinstance(dump, list) else ""),
            detail("File", Path(source_path).name if source_path else ""),
        ],
    }


def mode_state_context() -> dict[str, str]:
    path = env_path("GWAY_KIOSK_RFID_MODE_STATE_FILE", DEFAULT_RFID_MODE_STATE_FILE)
    payload = read_json_file(path)
    state_path = payload.get("state_path")
    if isinstance(state_path, list):
        state_path_text = "/".join(str(part) for part in state_path)
    else:
        state_path_text = ""
    return {
        "current_card": clean_text(payload.get("current_card") or "", 80),
        "hold_card": clean_text(payload.get("hold_card") or "", 80),
        "last_scan_card": clean_text(payload.get("last_scan_card") or "", 80),
        "last_scan_seen_at": display_datetime(payload.get("last_scan_seen_at")),
        "last_one_shot_card": clean_text(payload.get("last_one_shot_mode_card") or "", 80),
        "last_one_shot_reset_at": display_datetime(payload.get("last_one_shot_mode_reset_at")),
        "state_path": clean_text(state_path_text, 160),
        "updated_at": display_datetime(payload.get("updated_at")),
    }


def public_kiosk_takeover(payload: dict[str, Any]) -> dict[str, object]:
    status = str(payload.get("status") or "running").strip().lower()
    if status not in {"running", "complete", "failed", "error"}:
        status = "running"
    return {
        "active": True,
        "id": clean_text(payload.get("id"), 96),
        "kind": clean_text(payload.get("kind") or "card", 40),
        "title": clean_text(payload.get("title") or "Card", TAKEOVER_TITLE_LIMIT),
        "status": status,
        "summary": clean_text(payload.get("summary"), TAKEOVER_TEXT_LIMIT),
        "body": clean_text(payload.get("body"), TAKEOVER_BODY_LIMIT),
        "started_at": display_datetime(payload.get("started_at")),
        "updated_at": display_datetime(payload.get("updated_at")),
    }


def takeover_is_cleared_by_later_card(payload: dict[str, Any]) -> bool:
    clear_after = parse_datetime(payload.get("clear_on_next_card_after") or payload.get("started_at"))
    if clear_after is None:
        return False
    card_time = latest_card_time()
    return card_time is not None and card_time > clear_after


def kiosk_takeover_context() -> dict[str, object]:
    path = env_path("GWAY_KIOSK_TAKEOVER_FILE", DEFAULT_KIOSK_TAKEOVER_FILE)
    payload = read_json_file(path)
    if payload and not takeover_is_cleared_by_later_card(payload):
        return public_kiosk_takeover(payload)
    return {"active": False}


def system_uptime() -> str:
    path = env_path("GWAY_KIOSK_UPTIME_FILE", DEFAULT_UPTIME_FILE)
    try:
        text = path.read_text(encoding="utf-8").split()[0]
        seconds = float(text)
    except (OSError, IndexError, TypeError, ValueError):
        return ""
    return format_duration(seconds)


def system_os_name() -> str:
    path = env_path("GWAY_KIOSK_OS_RELEASE_FILE", DEFAULT_OS_RELEASE_FILE)
    values = read_key_value_file(path)
    pretty_name = values.get("PRETTY_NAME", "").strip().strip('"')
    if pretty_name:
        return pretty_name
    return platform.platform(terse=True)


def free_disk() -> str:
    path = env_path("GWAY_KIOSK_DISK_PATH", DEFAULT_DISK_PATH)
    try:
        usage = shutil.disk_usage(path)
    except OSError:
        return ""
    return f"{format_bytes(usage.free)} free"


def lcd_history_context() -> dict[str, object]:
    history_dir = env_path("GWAY_KIOSK_LCD_HISTORY_DIR", DEFAULT_LCD_HISTORY_DIR)
    entries: list[dict[str, str]] = []
    for index in range(3):
        path = history_dir / f"lcd-history-{index}.txt"
        try:
            lines = path.read_text(encoding="utf-8").splitlines()
        except OSError:
            continue
        for line in lines:
            try:
                parsed = json.loads(line)
            except json.JSONDecodeError:
                continue
            line1 = str(parsed.get("line1", "")).rstrip()
            line2 = str(parsed.get("line2", "")).rstrip()
            if not line1 and not line2:
                continue
            entries.append(
                {
                    "time": display_datetime(parsed.get("ts")),
                    "sort_time": str(parsed.get("ts") or ""),
                    "label": clean_text(parsed.get("label") or "LCD", 40),
                    "display_text": " || ".join(line for line in (line1, line2) if line),
                }
            )
    entries.sort(key=lambda item: item["sort_time"])
    return {"items": entries[-4:][::-1]}


def line_mentions_undervoltage(line: str) -> bool:
    lowered = line.lower()
    return ("under-voltage" in lowered or "undervoltage" in lowered) and (
        "detected" in lowered or "warning" in lowered
    )


def display_undervoltage_line(line: str) -> str:
    first_token = line.strip().split(maxsplit=1)[0] if line.strip() else ""
    if first_token:
        display = display_datetime(first_token)
        if display:
            return display
    return clean_text(line, 80)


def last_undervoltage_from_text(text: str) -> str:
    for line in reversed(text.splitlines()):
        if line_mentions_undervoltage(line):
            return display_undervoltage_line(line)
    return ""


def warning_commands_enabled() -> bool:
    return not os.environ.get("GWAY_KIOSK_ENABLE_WARNING_COMMANDS", "1").strip().lower() in {"0", "false", "no", "off"}


def last_undervoltage() -> str:
    configured_log = os.environ.get("GWAY_KIOSK_UNDERVOLTAGE_LOG_FILE", "").strip()
    if configured_log:
        try:
            text = Path(configured_log).read_text(encoding="utf-8")
        except OSError:
            text = ""
        found = last_undervoltage_from_text(text)
        if found:
            return found
    if not warning_commands_enabled():
        return "No recent event"
    journal = run_status_command(
        ["journalctl", "-k", "--no-pager", "-n", "200", "-o", "short-iso"],
        timeout=0.8,
    )
    found = last_undervoltage_from_text(journal)
    return found or "No recent event"


def throttle_flags() -> str:
    if not warning_commands_enabled():
        return "Unavailable"
    output = run_status_command(["vcgencmd", "get_throttled"], timeout=0.5)
    if not output:
        return "Unavailable"
    _key, separator, value = output.partition("=")
    return (value if separator else output).strip() or "Unavailable"


def cpu_temperature() -> str:
    path = env_path("GWAY_KIOSK_CPU_TEMP_FILE", DEFAULT_CPU_TEMP_FILE)
    try:
        raw_value = path.read_text(encoding="utf-8").strip()
        millidegrees = float(raw_value)
    except (OSError, TypeError, ValueError):
        return "Unavailable"
    return f"{millidegrees / 1000:.1f} C"


def warnings_context() -> dict[str, object]:
    return {
        "items": [
            detail("Last Undervoltage", last_undervoltage()),
            detail("Throttle Flags", throttle_flags()),
            detail("CPU Temp", cpu_temperature()),
        ]
    }


def node_context() -> dict[str, str]:
    return {
        "header": os.environ.get("GWAY_KIOSK_NODE_HEADER", "GWAY-001"),
        "hostname": socket.gethostname(),
        "node": os.environ.get("GWAY_KIOSK_NODE_NAME", socket.gethostname()),
        "role": os.environ.get("GWAY_KIOSK_NODE_ROLE", "Control"),
        "uptime": system_uptime(),
        "os": system_os_name(),
        "free_disk": free_disk(),
    }


def parse_todo_entries(text: str) -> list[dict[str, object]]:
    lines = text.splitlines()
    pending_index = None
    completed_index = None
    for index, line in enumerate(lines):
        stripped = line.strip()
        if stripped == "## Pending" and pending_index is None:
            pending_index = index
        elif stripped == "## Completed" and completed_index is None:
            completed_index = index
    if pending_index is None:
        return []
    if completed_index is None or completed_index < pending_index:
        completed_index = len(lines)
    section = lines[pending_index + 1 : completed_index]
    entries: list[list[str]] = []
    current: list[str] | None = None
    for line in section:
        if line.startswith("### "):
            if current is not None:
                entries.append(current)
            current = [line]
        elif current is not None:
            current.append(line)
    if current is not None:
        entries.append(current)

    parsed_entries: list[dict[str, object]] = []
    for number, entry in enumerate(entries, start=1):
        title = entry[0].removeprefix("### ").strip()
        fields: dict[str, str] = {}
        for line in entry[1:]:
            match = re.match(r"^-\s+([^:]+):\s*(.*)$", line)
            if match:
                fields[match.group(1).strip().lower()] = match.group(2).strip()
        status = fields.get("status") or "Pending."
        original = fields.get("original todo") or title
        parsed_entries.append(
            {
                "number": number,
                "title": clean_text(title, 120),
                "original": clean_text(original, 220),
                "status": clean_text(status, 120),
                "blocked": "block" in status.lower(),
            }
        )
    return parsed_entries


def last_workgroup_line(path: Path) -> str:
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return ""
    for line in reversed(lines):
        stripped = line.strip()
        if stripped and not stripped.startswith("#"):
            return stripped
    return ""


def work_status_context() -> dict[str, object]:
    path = env_path("GWAY_KIOSK_WORKGROUP_FILE", DEFAULT_WORKGROUP_FILE)
    raw = last_workgroup_line(path)
    if not raw:
        return {
            "active": False,
            "label": "Idle",
            "summary": "No current work item",
            "updated_at": "",
            "age": "",
        }
    stamp_text, separator, summary = raw.partition(" - ")
    parsed = parse_datetime(stamp_text) if separator else None
    summary = clean_text(summary if separator else raw, 180)
    max_age = timedelta(
        minutes=env_int(
            "GWAY_KIOSK_WORK_ACTIVE_MAX_AGE_MINUTES",
            DEFAULT_WORK_ACTIVE_MAX_AGE_MINUTES,
            minimum=1,
            maximum=10080,
        )
    )
    if parsed is not None:
        age_delta = datetime.now(timezone.utc) - parsed.astimezone(timezone.utc)
        active = age_delta <= max_age
        return {
            "active": active,
            "label": "Working" if active else "Idle",
            "summary": summary if active else f"Last: {summary}",
            "updated_at": display_datetime(parsed),
            "age": format_duration(age_delta.total_seconds()),
        }
    return {
        "active": True,
        "label": "Working",
        "summary": summary,
        "updated_at": display_datetime(file_mtime(path)),
        "age": "",
    }


def todo_context() -> dict[str, object]:
    path = env_path("GWAY_KIOSK_TODO_FILE", DEFAULT_TODO_FILE)
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        entries: list[dict[str, object]] = []
    else:
        entries = parse_todo_entries(text)
    limit = env_int("GWAY_KIOSK_TODO_LIMIT", DEFAULT_TODO_LIMIT, minimum=1, maximum=12)
    visible = entries[:limit]
    return {
        "items": visible,
        "count": len(entries),
        "visible_count": len(visible),
        "limit": limit,
        "updated_at": display_datetime(file_mtime(path)),
        "work_status": work_status_context(),
    }


def fingerprint(payload: dict[str, object]) -> str:
    ap = payload["ap"]
    last_card = payload["last_card"]
    relevant = {
        "layout": payload.get("layout_version"),
        "ap": {
            "ssid": ap.get("ssid"),
            "updated_at": ap.get("updated_at"),
        },
        "last_card": {
            "rfid": last_card.get("rfid"),
            "full_rfid": last_card.get("full_rfid"),
            "seen_at": last_card.get("seen_at"),
            "status": last_card.get("status"),
            "command": last_card.get("command"),
        },
        "node": payload["node"],
        "mode_state": payload["mode_state"],
        "lcd_history": payload["lcd_history"],
        "todo": payload["todo"],
        "warnings": [
            (item["label"], item["value"])
            for item in payload["warnings"].get("items", [])
            if item["label"] != "CPU Temp"
        ],
        "kiosk_takeover": payload["kiosk_takeover"],
        "field_view": payload["field_view"],
        "services": [
            (service["name"], service["state"]) for service in payload["services"]
        ],
    }
    encoded = json.dumps(relevant, sort_keys=True, default=str).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()


def build_payload(client_ip: str = "127.0.0.1") -> dict[str, object]:
    payload: dict[str, object] = {
        "title": "GWAY Kiosk",
        "layout_version": LAYOUT_VERSION,
        "refresh_seconds": env_int("GWAY_KIOSK_REFRESH_SECONDS", DEFAULT_REFRESH_SECONDS, minimum=2, maximum=3600),
        "generated_at": display_datetime(datetime.now(timezone.utc)),
        "node": node_context(),
        "ap": ap_context(client_ip),
        "portal": portal_health(),
        "services": service_statuses(),
        "last_card": last_card_context(),
        "mode_state": mode_state_context(),
        "lcd_history": lcd_history_context(),
        "warnings": warnings_context(),
        "todo": todo_context(),
        "kiosk_takeover": kiosk_takeover_context(),
        "field_view": field_view_context(),
    }
    payload["fingerprint"] = fingerprint(payload)
    return payload


def h(value: object) -> str:
    return html.escape(str(value if value is not None else ""), quote=True)


def render_detail_list(items: list[dict[str, object]]) -> str:
    return "\n".join(
        f"<dt>{h(item.get('label', ''))}</dt><dd>{h(item.get('value', '') or '-')}</dd>"
        for item in items
    )


def render_todo_items(todo: dict[str, object]) -> str:
    items = todo.get("items")
    if not isinstance(items, list) or not items:
        return '<p class="kiosk-empty">No pending TODOs</p>'
    rows: list[str] = []
    for raw in items:
        item = raw if isinstance(raw, dict) else {}
        classes = "kiosk-todo-item"
        if item.get("blocked"):
            classes += " is-blocked"
        rows.append(
            f'<div class="{classes}">'
            f'<span>{h(item.get("number", ""))}</span>'
            f'<div><strong>{h(item.get("title", ""))}</strong>'
            f'<em>{h(item.get("status", ""))}</em></div>'
            "</div>"
        )
    hidden = int(todo.get("count") or 0) - int(todo.get("visible_count") or 0)
    if hidden > 0:
        rows.append(f'<p class="kiosk-more">+{hidden} more</p>')
    return "\n".join(rows)


def render_lcd_items(lcd_history: dict[str, object]) -> str:
    items = lcd_history.get("items")
    if not isinstance(items, list) or not items:
        return '<p class="kiosk-empty">No LCD history</p>'
    rows: list[str] = []
    for raw in items:
        item = raw if isinstance(raw, dict) else {}
        rows.append(
            '<div class="kiosk-lcd-history__item">'
            '<div class="kiosk-lcd-history__meta">'
            f'<span>{h(item.get("label") or "LCD")}</span>'
            f'<time>{h(item.get("time") or "-")}</time>'
            "</div>"
            f'<div class="kiosk-lcd-history__frame"><span>{h(item.get("display_text") or " ")}</span></div>'
            "</div>"
        )
    return "\n".join(rows)


def render_services(payload: dict[str, object]) -> str:
    portal = payload["portal"]
    rows = [
        '<div class="kiosk-service {klass}"><span>{label}</span><strong>{state}</strong></div>'.format(
            klass="is-ok" if portal.get("ok") else "is-alert",
            label=h(portal.get("label")),
            state=h(portal.get("state")),
        )
    ]
    for raw in payload["services"]:
        service = raw if isinstance(raw, dict) else {}
        rows.append(
            '<div class="kiosk-service {klass}"><span>{label}</span><strong>{state}</strong></div>'.format(
                klass="is-ok" if service.get("ok") else "is-alert",
                label=h(service.get("label")),
                state=h(service.get("state")),
            )
        )
    return "\n".join(rows)


def render_html(payload: dict[str, object]) -> str:
    ap = payload["ap"]
    last_card = payload["last_card"]
    node = payload["node"]
    mode_state = payload["mode_state"]
    warnings = payload["warnings"]
    todo = payload["todo"]
    work_status = todo["work_status"]
    takeover = payload["kiosk_takeover"]
    field_view = payload["field_view"]
    takeover_classes = "kiosk-takeover"
    if takeover.get("active"):
        takeover_classes += f" is-active is-{h(takeover.get('status') or 'running')}"

    card_details = [
        detail("Seen", last_card.get("seen_at", "")),
        detail("Source", last_card.get("source", "")),
        detail("Full RFID", last_card.get("full_rfid", "")),
    ]
    for item in last_card.get("details", []):
        if item.get("value"):
            card_details.append(item)
    command = last_card.get("command") if isinstance(last_card.get("command"), dict) else {}
    card_details.extend(
        [
            detail("Command status", command.get("execution_status", "")),
            detail("Name", command.get("card_name", "")),
            detail("Command", command.get("command", "")),
            detail("Template", command.get("template", "")),
            detail("Detail", command.get("execution_detail", "")),
            detail("Current mode", mode_state.get("current_card", "")),
            detail("Hold mode", mode_state.get("hold_card", "")),
        ]
    )
    system_details = [
        detail("Host", node.get("hostname", "")),
        detail("Node", node.get("node", "")),
        detail("Role", node.get("role", "")),
        detail("Uptime", node.get("uptime", "")),
        detail("OS", node.get("os", "")),
        detail("Free Disk", node.get("free_disk", "")),
    ]
    system_details.extend(warnings.get("items", []))
    system_details.append(detail("Updated", payload.get("generated_at", "")))

    return f"""<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Cache-Control" content="no-store">
  <title>{h(payload["title"])}</title>
  <style>{CSS}</style>
</head>
<body>
<main
  class="kiosk-status"
  data-kiosk-status
  data-status-url="/kiosk/status/data/"
  data-field-view-url="/kiosk/status/field-view/"
  data-fingerprint="{h(payload["fingerprint"])}"
  data-refresh-seconds="{h(payload["refresh_seconds"])}"
  data-field-view-poll-seconds="{h(env_int("KIOSK_FIELD_VIEW_POLL_SECONDS", DEFAULT_FIELD_VIEW_POLL_SECONDS, minimum=1, maximum=30))}"
>
  <section
    class="{takeover_classes}"
    data-kiosk-takeover
    aria-live="polite"
    aria-hidden="{'false' if takeover.get('active') else 'true'}"
  >
    <div class="kiosk-takeover__shell">
      <div class="kiosk-takeover__meta">
        <span data-kiosk-takeover-kind>{h(takeover.get("kind") or "")}</span>
        <strong data-kiosk-takeover-status>{h(takeover.get("status") or "")}</strong>
      </div>
      <h1 data-kiosk-takeover-title>{h(takeover.get("title") or "")}</h1>
      <p data-kiosk-takeover-summary>{h(takeover.get("summary") or "")}</p>
      <div class="kiosk-takeover__progress" data-kiosk-takeover-progress><span></span></div>
      <pre data-kiosk-takeover-body>{h(takeover.get("body") or "")}</pre>
    </div>
  </section>
  <section
    class="kiosk-field-view{' is-active' if field_view.get('available') else ''}"
    data-kiosk-field-view
    aria-hidden="{'false' if field_view.get('available') else 'true'}"
  >
    <div class="kiosk-field-view__header">
      <span>Field charger console</span>
      <strong data-kiosk-field-view-status>{h(field_view.get("reason") or "")}</strong>
    </div>
    <iframe
      data-kiosk-field-view-frame
      title="Arthexis field charger console"
      referrerpolicy="no-referrer"
      src="{h(field_view.get("view_url") or "") if field_view.get("available") else ""}"
    ></iframe>
  </section>

  <section class="kiosk-status__grid" aria-label="Kiosk status">
    <div class="kiosk-status__column kiosk-status__column--ap">
      <article class="kiosk-panel kiosk-panel--ap">
        <div class="kiosk-panel__heading">
          <p>Access</p>
          <strong>{h(ap.get("interface") or "-")}</strong>
        </div>
        <div class="kiosk-ap-credentials">
          <div><span>SSID</span><strong>{h(ap.get("ssid") or "-")}</strong></div>
          <div><span>Password</span><strong>{h(ap.get("password") or ("Console only" if not ap.get("password_visible") else "-"))}</strong></div>
        </div>
        {f'<img class="kiosk-ap-qr" src="{h(ap.get("qr_data_uri"))}" alt="AP Wi-Fi QR code">' if ap.get("qr_data_uri") else ""}
        <dl class="kiosk-detail-list">
          <dt>Updated</dt><dd>{h(ap.get("updated_at_display") or "-")}</dd>
        </dl>
      </article>

      <article class="kiosk-panel kiosk-panel--todo">
        <div class="kiosk-panel__heading">
          <p>TODO</p>
          <strong>{h(work_status.get("label") or "Idle")}</strong>
        </div>
        <div class="kiosk-todo-status {'is-active' if work_status.get('active') else ''}">
          <strong>{h(work_status.get("label") or "Idle")}</strong>
          <span>{h(work_status.get("summary") or "")}</span>
        </div>
        <div class="kiosk-todo-list">
          {render_todo_items(todo)}
        </div>
      </article>
    </div>

    <div class="kiosk-status__column kiosk-status__column--cards">
      <article class="kiosk-panel kiosk-panel--card">
        <div class="kiosk-panel__heading">
          <p>Last Card</p>
          <strong>{h(last_card.get("status") or "idle")}</strong>
        </div>
        <div class="kiosk-last-card">
          <strong>{h(last_card.get("display_label") or "No card seen")}</strong>
          <span>{h(last_card.get("rfid") or "-")}</span>
        </div>
        <dl class="kiosk-detail-list">{render_detail_list(card_details)}</dl>
      </article>

      <article class="kiosk-panel kiosk-panel--lcd">
        <div class="kiosk-panel__heading">
          <p>LCD History</p>
          <strong>Last 4</strong>
        </div>
        <div class="kiosk-lcd-history">{render_lcd_items(payload["lcd_history"])}</div>
      </article>
    </div>

    <div class="kiosk-status__column kiosk-status__column--system">
      <article class="kiosk-panel kiosk-panel--node">
        <div class="kiosk-panel__heading">
          <p>System Info</p>
          <strong>{h(node.get("header") or "GWAY-001")}</strong>
        </div>
        <dl class="kiosk-detail-list">{render_detail_list(system_details)}</dl>
      </article>

      <article class="kiosk-panel kiosk-panel--status">
        <div class="kiosk-panel__heading">
          <p>Services</p>
          <strong>{"Online" if payload["portal"].get("ok") else "Check"}</strong>
        </div>
        <div class="kiosk-service-list">{render_services(payload)}</div>
      </article>
    </div>
  </section>
</main>
<script>{JS}</script>
</body>
</html>
"""


