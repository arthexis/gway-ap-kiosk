DEFAULT_CPU_TEMP_FILE = Path("/sys/class/thermal/thermal_zone0/temp")
DEFAULT_OS_RELEASE_FILE = Path("/etc/os-release")
DEFAULT_UPTIME_FILE = Path("/proc/uptime")
