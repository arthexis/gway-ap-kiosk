JS = r"""
(() => {
  const root = document.querySelector('[data-kiosk-status]');
  if (!root) {
    return;
  }
  const statusUrl = root.dataset.statusUrl || '/kiosk/status/data/';
  const refreshSeconds = Number.parseInt(root.dataset.refreshSeconds || '10', 10);
  const refreshMs = Math.max(2, refreshSeconds || 10) * 1000;
  const fieldViewUrl = root.dataset.fieldViewUrl || '/kiosk/status/field-view/';
  const fieldViewPollSeconds = Number.parseInt(root.dataset.fieldViewPollSeconds || '3', 10);
  const fieldViewPollMs = Math.max(1, fieldViewPollSeconds || 3) * 1000;
  const takeover = root.querySelector('[data-kiosk-takeover]');
  const takeoverKind = root.querySelector('[data-kiosk-takeover-kind]');
  const takeoverStatus = root.querySelector('[data-kiosk-takeover-status]');
  const takeoverTitle = root.querySelector('[data-kiosk-takeover-title]');
  const takeoverSummary = root.querySelector('[data-kiosk-takeover-summary]');
  const takeoverProgress = root.querySelector('[data-kiosk-takeover-progress]');
  const takeoverBody = root.querySelector('[data-kiosk-takeover-body]');
  const fieldView = root.querySelector('[data-kiosk-field-view]');
  const fieldViewStatus = root.querySelector('[data-kiosk-field-view-status]');
  const fieldViewFrame = root.querySelector('[data-kiosk-field-view-frame]');

  function setText(node, value) {
    if (node) {
      node.textContent = value || '';
    }
  }

  function renderTakeover(payload) {
    if (!takeover) {
      return false;
    }
    const active = Boolean(payload && payload.active);
    const status = active ? (payload.status || 'running') : '';
    takeover.classList.toggle('is-active', active);
    takeover.classList.toggle('is-running', status === 'running');
    takeover.classList.toggle('is-complete', status === 'complete');
    takeover.classList.toggle('is-failed', status === 'failed');
    takeover.classList.toggle('is-error', status === 'error');
    takeover.setAttribute('aria-hidden', active ? 'false' : 'true');

    setText(takeoverKind, active ? payload.kind || 'Card' : '');
    setText(takeoverStatus, status);
    setText(takeoverTitle, active ? payload.title || 'Card' : '');
    setText(takeoverSummary, active ? payload.summary || '' : '');
    setText(takeoverBody, active ? payload.body || '' : '');

    if (takeoverProgress) {
      takeoverProgress.hidden = !active || status !== 'running';
    }
    if (takeoverBody) {
      takeoverBody.hidden = !active || !(payload.body || '').trim();
    }
    return active;
  }

  function renderFieldView(payload) {
    if (!fieldView) {
      return;
    }
    const active = Boolean(payload && payload.available && payload.view_url);
    fieldView.classList.toggle('is-active', active);
    fieldView.setAttribute('aria-hidden', active ? 'false' : 'true');
    setText(fieldViewStatus, active ? payload.reason || 'live_ocpp_connection' : '');
    if (!fieldViewFrame) {
      return;
    }
    if (!active) {
      fieldViewFrame.removeAttribute('src');
      return;
    }
    if (fieldViewFrame.getAttribute('src') !== payload.view_url) {
      fieldViewFrame.setAttribute('src', payload.view_url);
    }
  }

  async function refreshFieldView() {
    if (document.hidden) {
      return;
    }
    try {
      const response = await fetch(fieldViewUrl, {
        cache: 'no-store',
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) {
        renderFieldView(null);
        return;
      }
      renderFieldView(await response.json());
    } catch (_error) {
      renderFieldView(null);
    }
  }

  async function refreshStatus() {
    if (document.hidden) {
      return;
    }
    try {
      const response = await fetch(statusUrl, {
        cache: 'no-store',
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) {
        return;
      }
      const payload = await response.json();
      const takeoverActive = renderTakeover(payload.kiosk_takeover);
      if (payload.fingerprint && payload.fingerprint !== root.dataset.fingerprint) {
        if (takeoverActive) {
          root.dataset.fingerprint = payload.fingerprint;
          return;
        }
        window.location.reload();
      }
    } catch (_error) {
      // The next polling interval will retry.
    }
  }

  window.setInterval(refreshStatus, refreshMs);
  window.setInterval(refreshFieldView, fieldViewPollMs);
  refreshFieldView();
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) {
      refreshStatus();
      refreshFieldView();
    }
  });
})();
"""


class KioskStatusHandler(http.server.BaseHTTPRequestHandler):
    server_version = "GWAYKioskStatus/1.0"

    def log_message(self, fmt: str, *args: object) -> None:
        sys.stderr.write("%s - %s\n" % (self.log_date_time_string(), fmt % args))

    def _client_ip(self) -> str:
        return str(self.client_address[0]) if self.client_address else ""

    def _send(self, status: int, content_type: str, body: bytes) -> None:
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self) -> None:
        if self.path.split("?", 1)[0] in {"/data", "/kiosk/status/data/"}:
            payload = build_payload(self._client_ip())
            body = json.dumps(payload, sort_keys=True, default=str).encode("utf-8")
            self._send(200, "application/json; charset=utf-8", body)
            return
        if self.path.split("?", 1)[0] in {"/field-view", "/kiosk/status/field-view/"}:
            body = json.dumps(field_view_context(), sort_keys=True).encode("utf-8")
            self._send(200, "application/json; charset=utf-8", body)
            return
        if self.path.split("?", 1)[0] in {"/", "/kiosk/", "/kiosk/status/"}:
            payload = build_payload(self._client_ip())
            body = render_html(payload).encode("utf-8")
            self._send(200, "text/html; charset=utf-8", body)
            return
        self._send(404, "text/plain; charset=utf-8", b"not found\n")


def run_server(host: str, port: int) -> int:
    server = http.server.ThreadingHTTPServer((host, port), KioskStatusHandler)
    server.daemon_threads = True
    print(f"serving gway kiosk status on http://{host}:{port}/", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        return 0
    finally:
        server.server_close()
    return 0


def self_test() -> int:
    payload = build_payload("127.0.0.1")
    body = render_html(payload)
    required = ("TODO", "System Info", "Last Undervoltage", "Services")
    missing = [text for text in required if text not in body]
    if missing:
        print(f"missing render text: {', '.join(missing)}", file=sys.stderr)
        return 1
    if "kiosk-panel--warnings" in body:
        print("obsolete warnings panel rendered", file=sys.stderr)
        return 1
    json.dumps(payload, sort_keys=True, default=str)
    return 0


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--host", default=os.environ.get("GWAY_KIOSK_HOST", "127.0.0.1"))
    parser.add_argument("--port", type=int, default=env_int("GWAY_KIOSK_PORT", 8899, minimum=1, maximum=65535))
    parser.add_argument("--json", action="store_true", help="Print one JSON payload and exit.")
    parser.add_argument("--self-test", action="store_true", help="Build and validate one kiosk page.")
    args = parser.parse_args(argv)

    if args.self_test:
        return self_test()
    if args.json:
        print(json.dumps(build_payload("127.0.0.1"), sort_keys=True, indent=2, default=str))
        return 0
    return run_server(args.host, args.port)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
