#!/usr/bin/env python3
"""Standalone local AP and kiosk status page; no external application integrations."""
import argparse
import html
import http.server
import ipaddress
import json
import os
from pathlib import Path
import subprocess
import sys
import threading
import time
from datetime import datetime, timezone

AP_RESET_PATH = "/kiosk/status/ap/reset/"
AP_ROTATE_COMMAND = Path("/usr/local/sbin/kiosk-ap")
AP_STATUS_COMMAND = Path("/usr/local/sbin/kiosk-ap")


def truthy(value):
    return str(value or "").lower() in {"1", "yes", "true", "on"}


def client_is_loopback(address):
    try:
        return ipaddress.ip_address(address).is_loopback
    except ValueError:
        return False


# Probe NetworkManager outside HTTP handlers; requests only read this snapshot.
AP_POLL_SECONDS = 5
AP_STALE_SECONDS = 30
AP_PROBE_TIMEOUT = 15


def empty_ap(state="unavailable"):
    return {"available": False, "ssid": "", "interface": "",
            "updated_at": "", "state": state}


class APStatusSnapshot:
    def __init__(self, clock=time.monotonic):
        self.clock = clock
        self.lock = threading.Lock()
        self.data = empty_ap()
        self.sampled_at = None

    def update(self, data):
        with self.lock:
            self.data = data
            self.sampled_at = self.clock()

    def read(self):
        with self.lock:
            data = dict(self.data)
            sampled_at = self.sampled_at
        if sampled_at is not None and self.clock() - sampled_at > AP_STALE_SECONDS:
            data["state"] = "stale"
            data["available"] = False
        elif sampled_at is None:
            data["state"] = "stale"
        return data


AP_SNAPSHOT = APStatusSnapshot()


def probe_ap():
    if not AP_STATUS_COMMAND.is_file():
        return empty_ap()
    try:
        result = subprocess.run(
            [str(AP_STATUS_COMMAND), "status"], capture_output=True,
            text=True, check=False, timeout=AP_PROBE_TIMEOUT,
        )
        data = json.loads(result.stdout)
        state = data.get("state", "unavailable")
        if state not in {"selected", "not_configured", "ambiguous",
                         "invalid_selection", "unavailable"}:
            state = "unavailable"
        ap = data.get("ap") or {}
        return {"available": state == "selected",
                "ssid": str(ap.get("ssid") or "") if state == "selected" else "",
                "interface": str(ap.get("interface") or "") if state == "selected" else "",
                "updated_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
                "state": state}
    except subprocess.TimeoutExpired:
        return None  # Retain last known sample; freshness will mark it stale.
    except (OSError, subprocess.SubprocessError, ValueError, TypeError, AttributeError):
        return empty_ap()


def poll_ap(snapshot=AP_SNAPSHOT, probe=probe_ap, pause=time.sleep):
    while True:
        result = probe()
        if result is not None:
            snapshot.update(result)
        pause(AP_POLL_SECONDS)


def ap_context(client_ip="127.0.0.1"):
    return AP_SNAPSHOT.read()


def build_payload(client_ip="127.0.0.1"):
    return {"title": "GWAY Kiosk", "ap": ap_context(client_ip)}


def render_html(payload):
    ap = payload["ap"]
    ssid = html.escape(ap["ssid"])
    interface = html.escape(ap["interface"])
    updated = html.escape(ap["updated_at"])
    rotate_button = (
        '<form method="post" action="/kiosk/status/ap/reset/">'
        '<button type="submit">Rotate AP password</button></form>'
        if truthy(os.environ.get("GWAY_KIOSK_ALLOW_AP_ROTATION")) else ""
    )
    return f"""<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>GWAY Kiosk</title><style>
body{{font:1.1rem system-ui,sans-serif;background:#121821;color:#f5f7fa;margin:0;padding:2rem}}
main{{max-width:45rem;margin:auto}}section{{background:#202b38;padding:1.5rem;border-radius:1rem}}
dt{{color:#a9b8c8;margin-top:1rem}}dd{{margin:.2rem 0}}button{{padding:.7rem 1.2rem}}
</style></head><body><main><h1>GWAY Kiosk</h1><section><h2>Access point</h2>
<dl><dt>SSID</dt><dd>{ssid or "Unavailable"}</dd><dt>Interface</dt><dd>{interface or "Unknown"}</dd>
<dt>Status</dt><dd>{html.escape(ap["state"])}</dd><dt>Updated</dt><dd>{updated or "Not yet sampled"}</dd></dl>{rotate_button}</section></main></body></html>"""


def reset_access_point():
    if not AP_ROTATE_COMMAND.is_file() or not os.access(AP_ROTATE_COMMAND, os.X_OK):
        return False
    try:
        return subprocess.run(
            ["sudo", "-n", str(AP_ROTATE_COMMAND), "rotate"], capture_output=True, check=False, timeout=60
        ).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


class KioskStatusHandler(http.server.BaseHTTPRequestHandler):
    def _send(self, code, kind, body):
        self.send_response(code)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def do_GET(self):
        path = self.path.split("?", 1)[0]
        if path in ("/data", "/kiosk/status/data/"):
            body = json.dumps(build_payload()).encode()
            return self._send(200, "application/json; charset=utf-8", body)
        if path in ("/", "/kiosk/", "/kiosk/status/"):
            return self._send(200, "text/html; charset=utf-8", render_html(build_payload()).encode())
        return self._send(404, "text/plain; charset=utf-8", b"not found\n")

    def do_HEAD(self):
        self.do_GET()

    def do_POST(self):
        if self.path.split("?", 1)[0] != AP_RESET_PATH:
            return self._send(404, "text/plain; charset=utf-8", b"not found\n")
        host = self.headers.get("Host", "")
        origin = self.headers.get("Origin", "")
        if (
            not client_is_loopback(self.client_address[0])
            or not truthy(os.environ.get("GWAY_KIOSK_ALLOW_AP_ROTATION"))
            or host not in {"localhost", "127.0.0.1", "[::1]", "localhost:8899", "127.0.0.1:8899", "[::1]:8899"}
            or origin not in {"http://" + host, "https://" + host}
        ):
            return self._send(403, "application/json", b'{"ok":false}')
        ok = reset_access_point()
        return self._send(200 if ok else 502, "application/json", json.dumps({"ok": ok}).encode())


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--host", default=os.environ.get("GWAY_KIOSK_HOST", "127.0.0.1"))
    parser.add_argument("--port", type=int, default=int(os.environ.get("GWAY_KIOSK_PORT", "8899")))
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--self-test", action="store_true")
    args = parser.parse_args(argv)
    if args.self_test:
        assert "GWAY Kiosk" in render_html(build_payload())
        return 0
    if args.json:
        print(json.dumps(build_payload(), indent=2))
        return 0
    if not client_is_loopback(args.host):
        parser.error("kiosk status must bind to a loopback address")
    threading.Thread(target=poll_ap, daemon=True, name="ap-status-probe").start()
    server = http.server.ThreadingHTTPServer((args.host, args.port), KioskStatusHandler)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
