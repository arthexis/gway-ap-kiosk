[Unit]
Description=Arthexis VNC kiosk prototype on display :99
Documentation=man:Xvnc(1)
After=network-online.target gway-kiosk-status.service
Wants=network-online.target gway-kiosk-status.service
ConditionPathExists=/etc/arthexis-kiosk/vnc.conf

[Service]
Type=forking
User=vnc-kiosk
Group=vnc-kiosk
WorkingDirectory=/var/lib/arthexis-vnc-kiosk
Environment=HOME=/var/lib/arthexis-vnc-kiosk
EnvironmentFile=/etc/default/arthexis-vnc-kiosk
PIDFile=/var/lib/arthexis-vnc-kiosk/.vnc/%H:99.pid
ExecStartPre=-/usr/bin/vncserver-virtual -kill :99
ExecStartPre=/usr/bin/vncserver-virtual -clean
ExecStart=/usr/bin/vncserver-virtual :99 -geometry ${KIOSK_GEOMETRY} -depth ${KIOSK_DEPTH} -vncconfigfile ${KIOSK_VNC_CONFIG}
ExecStop=/usr/bin/vncserver-virtual -kill :99
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/arthexis-vnc-kiosk /tmp
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
IPAddressAllow=::1/128
CapabilityBoundingSet=
LockPersonality=yes
RemoveIPC=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
