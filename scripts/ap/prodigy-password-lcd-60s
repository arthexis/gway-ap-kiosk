#!/usr/bin/env bash
set -euo pipefail

password_file="${PRODIGY_PASSWORD_FILE:-/home/arthe/ap-password.txt}"
lcd_dir="${RFID_MODE_LCD_LOCK_DIR:-${LCD_LOCK_DIR:-/home/arthe/.local/state/lcd-lockfiles}}"
lcd_event_id="${PRODIGY_PASSWORD_LCD_EVENT_ID:-12}"
seconds="${PRODIGY_PASSWORD_LCD_SECONDS:-60}"
dry_run=0

if [[ "${1:-}" == "--dry-run" ]]; then
  dry_run=1
fi

die() {
  printf 'prodigy-password-lcd-60s: %s\n' "$*" >&2
  exit 1
}

if ! [[ "$seconds" =~ ^[0-9]+$ ]] || [[ "$seconds" -le 0 ]]; then
  die "invalid display seconds: $seconds"
fi

[[ -r "$password_file" ]] || die "password file is not readable: $password_file"

ssid=""
password=""
while IFS='=' read -r key value; do
  case "$key" in
    SSID) ssid="$value" ;;
    PASSWORD) password="$value" ;;
  esac
done <"$password_file"

[[ -n "$ssid" ]] || ssid="arthexis-1"
[[ -n "$password" ]] || die "password file has no PASSWORD entry"

line1="${PRODIGY_PASSWORD_LCD_LINE1:-${ssid} PASS}"
line2="$password"
expires="$(python3 - "$seconds" <<'PY'
import sys
from datetime import datetime, timedelta, timezone

seconds = int(sys.argv[1])
print((datetime.now(timezone.utc) + timedelta(seconds=seconds)).isoformat())
PY
)"

signal_lcd() {
  local pid
  if [[ -r "$lcd_dir/lcd.pid" ]]; then
    pid="$(tr -dc '0-9' <"$lcd_dir/lcd.pid" 2>/dev/null || true)"
    if [[ -n "$pid" && "$pid" != "0" && "$pid" != "1" ]]; then
      kill -USR1 "$pid" 2>/dev/null || true
    fi
  fi
}

if [[ "$dry_run" -eq 1 ]]; then
  printf '{"ok":true,"dry_run":true,"ssid":"%s","lcd_event_id":%s,"seconds":%s,"password_length":%s}\n' \
    "$ssid" "$lcd_event_id" "$seconds" "${#password}"
  exit 0
fi

mkdir -p "$lcd_dir"
rm -f "$lcd_dir/lcd-event-0.lck" "$lcd_dir/lcd-event-10.lck"
umask 077
{
  printf '%s\n' "${line1:0:16}"
  printf '%s\n' "${line2:0:16}"
  printf '%s\n' "$expires"
} >"$lcd_dir/lcd-event-${lcd_event_id}.lck"
chmod 600 "$lcd_dir/lcd-event-${lcd_event_id}.lck"
signal_lcd

printf '{"ok":true,"ssid":"%s","lcd_event_id":%s,"seconds":%s,"password_length":%s}\n' \
  "$ssid" "$lcd_event_id" "$seconds" "${#password}"
