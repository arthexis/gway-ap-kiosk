#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import secrets
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path


PROFILE_ID = os.environ.get("PRODIGY_AP_PROFILE_ID", "PRODIGY")
AP_INTERFACE = os.environ.get("PRODIGY_AP_INTERFACE", "wlan0")
PASSWORD_PATH = Path(
    os.environ.get("PRODIGY_AP_PASSWORD_PATH", "/home/arthe/ap-password.txt")
).expanduser()
BOOT_ID_PATH = Path("/proc/sys/kernel/random/boot_id")
STATE_PATH = Path(
    os.environ.get("PRODIGY_AP_PASSWORD_STATE_PATH", "/var/lib/prodigy-ap-password/state.json")
).expanduser()
CONNECTION_DIR = Path(
    os.environ.get("NETWORKMANAGER_CONNECTION_DIR", "/etc/NetworkManager/system-connections")
).expanduser()
ALPHABET = "abcdefghjkmnpqrstuvwxyz23456789"


def run(command: list[str], *, check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(command, text=True, capture_output=True, check=check)


def networkmanager_active() -> bool:
    return (
        run(["systemctl", "is-active", "--quiet", "NetworkManager.service"], check=False).returncode
        == 0
    )


def default_password_length() -> int:
    raw = os.environ.get("PRODIGY_AP_PASSWORD_LENGTH", "12")
    try:
        value = int(raw)
    except ValueError:
        value = 12
    return max(8, min(value, 63))


def generate_password(length: int | None = None) -> str:
    if length is None:
        length = default_password_length()
    return "".join(secrets.choice(ALPHABET) for _ in range(length))


def boot_id() -> str:
    try:
        return BOOT_ID_PATH.read_text(encoding="utf-8").strip()
    except OSError:
        return "unknown"


def read_state() -> dict[str, object]:
    try:
        payload = json.loads(STATE_PATH.read_text(encoding="utf-8"))
    except (FileNotFoundError, OSError, json.JSONDecodeError):
        return {}
    return payload if isinstance(payload, dict) else {}


def write_state(action: str) -> None:
    STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    payload = {
        "action": action,
        "boot_id": boot_id(),
        "password_path": str(PASSWORD_PATH),
        "updated_at": datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds"),
    }
    STATE_PATH.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    STATE_PATH.chmod(0o600)


def read_password_file() -> str:
    values: dict[str, str] = {}
    try:
        lines = PASSWORD_PATH.read_text(encoding="utf-8").splitlines()
    except FileNotFoundError:
        return ""
    for line in lines:
        key, separator, value = line.partition("=")
        if not separator:
            continue
        values[key.strip()] = value
    return values.get("PASSWORD", "").strip()


def find_profile_file(profile_id: str) -> Path:
    candidates = sorted(CONNECTION_DIR.glob("*.nmconnection"))
    for path in candidates:
        section = ""
        try:
            lines = path.read_text(encoding="utf-8").splitlines()
        except OSError:
            continue
        for line in lines:
            stripped = line.strip()
            if stripped.startswith("[") and stripped.endswith("]"):
                section = stripped[1:-1]
                continue
            if section == "connection" and stripped == f"id={profile_id}":
                return path
    raise FileNotFoundError(f"NetworkManager profile {profile_id!r} not found")


def set_key(lines: list[str], section_name: str, key: str, value: str) -> list[str]:
    result: list[str] = []
    section = ""
    in_target = False
    replaced = False
    inserted = False

    for line in lines:
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            if in_target and not replaced:
                result.append(f"{key}={value}")
                inserted = True
            section = stripped[1:-1]
            in_target = section == section_name
            result.append(line)
            continue

        if in_target and stripped.startswith(f"{key}="):
            if not replaced:
                result.append(f"{key}={value}")
                replaced = True
            continue

        result.append(line)

    if in_target and not replaced and not inserted:
        result.append(f"{key}={value}")

    return result


def update_profile_file(profile_path: Path, password: str) -> None:
    original = profile_path.read_text(encoding="utf-8").splitlines()
    updated = set_key(original, "wifi", "hidden", "false")
    updated = set_key(updated, "wifi", "ssid", PROFILE_ID)
    updated = set_key(updated, "wifi-security", "key-mgmt", "wpa-psk")
    updated = set_key(updated, "wifi-security", "psk", password)
    payload = "\n".join(updated) + "\n"

    stat = profile_path.stat()
    with tempfile.NamedTemporaryFile(
        "w",
        encoding="utf-8",
        dir=str(profile_path.parent),
        delete=False,
    ) as handle:
        handle.write(payload)
        temp_name = handle.name
    os.chmod(temp_name, stat.st_mode & 0o777)
    os.chown(temp_name, stat.st_uid, stat.st_gid)
    os.replace(temp_name, profile_path)


def write_password_file(password: str) -> None:
    updated_at = datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds")
    payload = "\n".join(
        [
            f"SSID={PROFILE_ID}",
            f"PASSWORD={password}",
            f"UPDATED_AT={updated_at}",
            f"INTERFACE={AP_INTERFACE}",
            "",
        ]
    )
    PASSWORD_PATH.write_text(payload, encoding="utf-8")
    shutil.chown(PASSWORD_PATH, user="arthe", group="arthe")
    PASSWORD_PATH.chmod(0o600)


def apply_password(password: str) -> None:
    if networkmanager_active():
        result = run(
            [
                "/usr/bin/nmcli",
                "connection",
                "modify",
                PROFILE_ID,
                "802-11-wireless.hidden",
                "no",
                "802-11-wireless.ssid",
                PROFILE_ID,
                "wifi-sec.key-mgmt",
                "wpa-psk",
                "wifi-sec.psk",
                password,
            ],
            check=False,
        )
        if result.returncode != 0:
            detail = (result.stderr or result.stdout or "unknown nmcli error").strip()
            raise RuntimeError(detail)
    profile_path = find_profile_file(PROFILE_ID)
    update_profile_file(profile_path, password)


def rotate_password() -> str:
    password = generate_password()
    apply_password(password)
    write_password_file(password)
    write_state("rotate")
    return password


def ensure_password() -> str:
    password = read_password_file()
    if not password:
        return rotate_password()
    apply_password(password)
    write_state("ensure")
    return password


def boot_rotate_password() -> str:
    password = read_password_file()
    state = read_state()
    if password and state.get("boot_id") == boot_id():
        apply_password(password)
        write_state("ensure")
        return password
    return rotate_password()


def main() -> int:
    parser = argparse.ArgumentParser(description="Manage the PRODIGY AP password.")
    parser.add_argument("command", choices=["boot-rotate", "ensure", "rotate", "reveal"])
    parser.add_argument("--show", action="store_true", help="Print the password (reveal always prints it).")
    args = parser.parse_args()

    if os.geteuid() != 0:
        print("Run as root.", file=sys.stderr)
        return 1

    try:
        if args.command == "reveal":
            profile = find_profile_file(PROFILE_ID)
            section = ""
            password = None
            for line in profile.read_text(encoding="utf-8").splitlines():
                stripped = line.strip()
                if stripped.startswith("[") and stripped.endswith("]"):
                    section = stripped[1:-1]
                elif section == "wifi-security" and stripped.startswith("psk="):
                    password = stripped.partition("=")[2]
                    break
            if not password:
                raise RuntimeError("Active AP profile has no readable PSK")
        elif args.command == "boot-rotate":
            password = boot_rotate_password()
        elif args.command == "ensure":
            password = ensure_password()
        else:
            password = rotate_password()
    except Exception as exc:
        print(f"prodigy-ap-password: {type(exc).__name__} (no credentials disclosed)", file=sys.stderr)
        return 1

    if args.show or args.command == "reveal":
        print(password)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
