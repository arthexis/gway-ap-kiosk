#!/usr/bin/env bash
# The legacy implementation flushed host_security.ap_allowed_macs, deleting
# independently managed permissions. Fail closed until reviewed cutover.
set -euo pipefail
if [[ "${GWAY_AP_CUTOVER_APPROVED:-}" != "1" ]]; then
    echo "legacy AP authorization sync is disabled until coordinated cutover" >&2
    exit 3
fi
STATE_DIR="${STATE_DIR:-${GWAY_AP_STATE_DIR:-/var/lib/gway-ap-kiosk/portal}}"
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec /usr/bin/python3 "${here}/../portal_authorization_reconcile.py" --state-dir "${STATE_DIR}" --broker-socket /run/gway-ap-nft/broker.sock
